# User service. Install:
#   mkdir -p ~/.config/systemd/user && cp docs/open-source-nvr.service.example ~/.config/systemd/user/open-source-nvr.service
#   edit WorkingDirectory/PATH, then:
#   systemctl --user daemon-reload && systemctl --user enable --now open-source-nvr
#   sudo loginctl enable-linger $USER
[Unit]
Description=Open Source NVR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/FOSS-nvrplus
Environment=PATH=%h/FOSS-nvrplus/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=LOG_LEVEL=info
ExecStart=/usr/bin/node lib/server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
